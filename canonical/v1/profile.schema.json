{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.doubak.com/canonical/v1/profile.schema.json",
  "title": "doubak canonical 1.3 — account profile (profile.ndjson)",
  "description": "Verified target profile; keyed by numeric UID. Missing fields are unobserved, a null avatar is an observed default.",
  "type": "object",
  "required": [
    "canonical_version",
    "identity_layer",
    "upstream_id",
    "account",
    "revisions"
  ],
  "additionalProperties": true,
  "properties": {
    "canonical_version": {
      "$ref": "common.schema.json#/$defs/canonical_version"
    },
    "identity_layer": {
      "enum": [
        "upstream_id"
      ]
    },
    "upstream_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "account": {
      "type": "object",
      "description": "目标主页所属账号；user_id 必须与 upstream_id 相同。",
      "required": [
        "user_id"
      ],
      "additionalProperties": true,
      "properties": {
        "user_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "nickname": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "description": "按 `first_observed_at` 升序。",
      "items": {
        "$ref": "#/$defs/revision"
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "required": [
        "parser_version",
        "first_observed_at",
        "last_observed_at",
        "fields",
        "digests",
        "observations"
      ],
      "additionalProperties": true,
      "properties": {
        "parser_version": {
          "$ref": "common.schema.json#/$defs/parser_version"
        },
        "first_observed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "last_observed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "fields": {
          "type": "object",
          "description": "这一版的字段快照。来自页面的字段一个都不设必填。",
          "additionalProperties": true,
          "properties": {
            "username": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "nickname": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "avatar_url": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "digests": {
          "type": "object",
          "description": "逐字段摘要。键集必须与 `fields` 严格一致。",
          "additionalProperties": false,
          "properties": {
            "username": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "nickname": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "avatar_url": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/observation"
          }
        }
      }
    }
  }
}
